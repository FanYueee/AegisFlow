{
  "title": "AegisFlow Overview",
  "uid": "aegisflow-overview",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Flow samples / sec",
      "description": "Rate of flow messages received across sFlow/NetFlow/IPFIX.",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
          "expr": "sum(rate(flow_samples_total[5m]))",
          "legendFormat": "samples/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Traffic by protocol",
      "description": "flow_bytes_total, converted to bits/sec, summed per L4 protocol.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
          "expr": "sum by (proto) (rate(flow_bytes_total[5m])) * 8",
          "legendFormat": "{{proto}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Packets by protocol",
      "description": "flow_packets_total rate, summed per L4 protocol.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
          "expr": "sum by (proto) (rate(flow_packets_total[5m]))",
          "legendFormat": "{{proto}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Traffic by interface",
      "description": "flow_bytes_total, converted to bits/sec, summed per ingress interface index.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aegisflow-prometheus" },
          "expr": "sum by (in_if) (rate(flow_bytes_total[5m])) * 8",
          "legendFormat": "in_if {{in_if}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
